# ======================================================
# Copiá este archivo como ".env" y completá los valores:
#   cp .env.example .env
# ======================================================

# --- Base de datos (para correr SIN Docker) ---
# Dentro de docker-compose esta variable se pisa automáticamente
# con el host "db", así que no hace falta tocarla para Docker.
DATABASE_URL=postgresql://monitor:monitor@localhost:5432/monitor

# --- JWT ---
# Usá una clave larga y aleatoria (ej: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiame_por_una_clave_larga_y_aleatoria

# --- Broker MQTT (telemetría de los ESP32) ---
# Si lo dejás vacío, la API arranca igual pero sin ingesta de datos MQTT.
MQTT_BROKER=161.35.100.210
MQTT_PORT=1884
MQTT_USERNAME=juli
MQTT_PASSWORD=juliBAR
MQTT_TOPIC=datos/sensores/#


DB_PASSWORD="admin"
